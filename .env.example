# ============================================================
# SalesIn - Configuracoes de Ambiente
# ============================================================

# SQL Server
DB_SERVER=localhost\SQLEXPRESS
DB_DATABASE=SalesIn

# Autenticacao
# Deixar vazio caso seja utilizada autenticacao do Windows.
DB_USER=
DB_PASSWORD=

# Driver SQL Server
DB_DRIVER=ODBC Driver 18 for SQL Server

# Aplicacao
APP_NAME=SalesIn
APP_VERSION=1.0.0
APP_ENV=development

# Inteligencia Artificial
# Configurar futuramente no arquivo .env local
OPENAI_API_KEY=